@* One track in the comparison table: badge, format, then the track name. *@
@if (Track == null)
{
    <span class="sv-missing">No track</span>
}
else
{
    <div>
        <TrackBadge Track="Track"/>
        <code>@Track.FormatSummary</code>
        @if (Track.StreamSizeText is { } size)
        {
            <span class="small text-muted ms-1 text-nowrap" title="Stream size">@size</span>
        }
    </div>
    @if (!string.IsNullOrEmpty(Track.Title))
    {
        <div class="small mt-1">@Track.Title</div>
    }
    @if (Track.Flags.Any())
    {
        <div class="small text-muted">@string.Join(", ", Track.Flags)</div>
    }
}

@code {
    [Parameter] public TrackInfo? Track { get; set; }
}
