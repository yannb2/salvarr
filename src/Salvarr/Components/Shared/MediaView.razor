@* Everything about one file: general facts, tracks, tags and chapters. *@
<div class="row g-3">
    <div class="col-12 col-xl-4">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-file-earmark-play me-2"></i>General</div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-5">Container</dt>
                    <dd class="col-7">@Details.Container</dd>
                    <dt class="col-5">Size</dt>
                    <dd class="col-7">@Format.Size(Details.SizeBytes)</dd>
                    <dt class="col-5">Duration</dt>
                    <dd class="col-7">@Format.Duration(Details.Duration)</dd>
                    @if (Details.BitRate is { } bitRate)
                    {
                        <dt class="col-5">Overall bit rate</dt>
                        <dd class="col-7">@Format.BitRate(bitRate)</dd>
                    }
                    <dt class="col-5">File title</dt>
                    <dd class="col-7 sv-file-name">
                        @if (string.IsNullOrEmpty(Details.Title))
                        {
                            <span class="sv-missing">None</span>
                        }
                        else
                        {
                            @Details.Title
                        }
                    </dd>
                    <dt class="col-5">Chapters</dt>
                    <dd class="col-7">@Details.Chapters.Count</dd>
                    <dt class="col-5">Attachments</dt>
                    <dd class="col-7">@Details.Attachments</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-8">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-list-ol me-2"></i>Tracks</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0 sv-track-table align-middle">
                    <thead>
                    <tr>
                        <th class="ps-3" style="width: 35px;">#</th>
                        <th>Language</th>
                        <th>Format</th>
                        <th>Name</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var track in Details.Tracks)
                    {
                        <tr>
                            <td class="ps-3">@track.Index</td>
                            <td><TrackBadge Track="track"/></td>
                            <td><code>@track.FormatSummary</code></td>
                            <td class="small">@track.Title</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-6">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-tags me-2"></i>Tags</div>
            <div class="card-body p-0">
                @if (Details.Tags.Count == 0)
                {
                    <p class="sv-missing m-3">No global tags.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tbody>
                        @foreach (var tag in Details.Tags)
                        {
                            <tr>
                                <td class="ps-3 text-muted text-nowrap"><code>@tag.Key</code></td>
                                <td class="sv-file-name">@tag.Value</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-6">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-bookmark me-2"></i>Chapters</div>
            <div class="card-body p-0">
                @if (Details.Chapters.Count == 0)
                {
                    <p class="sv-missing m-3">No chapters.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tbody>
                        @foreach (var (chapter, i) in Details.Chapters.Select((c, i) => (c, i)))
                        {
                            <tr>
                                <td class="ps-3 text-muted" style="width: 3rem;">@(i + 1)</td>
                                <td class="text-muted" style="width: 6rem;">@Format.Duration(chapter.Start)</td>
                                <td>@chapter.Title</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] [EditorRequired] public required MediaDetails Details { get; set; }
}
