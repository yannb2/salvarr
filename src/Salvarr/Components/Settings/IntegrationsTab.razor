@inject LiveSettings Settings

<p class="text-body-secondary small">
    Radarr and Sonarr tell Salvarr how long they keep deleted files, and get a rescan after a restore.
    What is saved here (in <span class="sv-path">@Settings.FilePath</span>) wins over the
    <code>Salvarr__Radarr__…</code> and <code>Salvarr__Sonarr__…</code> environment variables, which only give the starting values.
</p>

<div class="row g-3">
    <div class="col-12 col-xl-6">
        <ArrCard App="Radarr" Key="@LiveSettings.RadarrKey" Icon="bi-film" Example="http://radarr:7878"
                 Use="Used for the time left on files in Radarr's bin, and to rescan a movie after a restore."/>
    </div>
    <div class="col-12 col-xl-6">
        <ArrCard App="Sonarr" Key="@LiveSettings.SonarrKey" Icon="bi-tv" Example="http://sonarr:8989"
                 Use="Used for the time left on files in Sonarr's bin, and to rescan a show after a restore."/>
    </div>
</div>
