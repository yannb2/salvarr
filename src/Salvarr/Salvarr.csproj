<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Version>0.3.0</Version>
        <InvariantGlobalization>false</InvariantGlobalization>
        <!-- The SDK only adds blazor.web.js when it sees .razor files at restore time.
             The Dockerfile restores from the .csproj alone, so say it here. -->
        <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    </PropertyGroup>

    <ItemGroup>
        <!-- ctime (when a file was moved into the recycle bin) is not in System.IO. -->
        <PackageReference Include="Mono.Posix.NETStandard" Version="1.0.0" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Salvarr.Tests" />
    </ItemGroup>

</Project>
