{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Salvarr": {
    "Libraries": [
      { "Name": "Movies", "Path": "/movies", "Kind": "Movies" },
      { "Name": "TV", "Path": "/tv", "Kind": "Series" }
    ],
    "RecycleFolderNames": [ ".recycle" ],
    "SearchDepth": 2,
    "DetectHdr10Plus": true,
    "ReadDolbyVision": true,
    "AllowChanges": false,
    "Radarr": { "Url": "", "ApiKey": "" },
    "Sonarr": { "Url": "", "ApiKey": "" }
  }
}
